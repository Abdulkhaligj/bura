# Lokal: bu faylı .env adı ilə kopyala və dəyərləri doldur. .env git-ə düşmür.
# Vercel-də eyni adları Settings → Environment Variables bölməsinə yaz.

# AI — birini doldurmaq kifayətdir. İkisi də varsa DeepSeek seçilir (AI_PROVIDER ilə dəyişmək olar).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-flash

# Yalnız Vercel / uzaq baza üçün (lokal server .local/bura.sqlite istifadə edir)
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# BURA_FREE_JOB_LIMIT=5
